# Named .local so Railway keeps building with Railpack instead of this file.
# Build context is the repo root (workspace): see docker-compose.yml.
FROM oven/bun:1.4.4-slim

WORKDIR /app
RUN chown bun:bun /app
USER bun

# Every workspace package.json must be present for --frozen-lockfile; --filter then
# installs only the backend and what it depends on (incl. packages/shared).
COPY --chown=bun:bun package.json bun.lock bunfig.toml ./
COPY --chown=bun:bun backend/package.json backend/
COPY --chown=bun:bun frontend/package.json frontend/
COPY --chown=bun:bun packages/shared/package.json packages/shared/
RUN bun install --frozen-lockfile --filter frontpage-backend

COPY --chown=bun:bun packages packages
COPY --chown=bun:bun backend backend

WORKDIR /app/backend
EXPOSE 4000
CMD ["bun", "--watch", "src/index.ts"]
