{
    "name": "frontpage-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "start": "bun src/index.ts",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@frontpage/shared": "workspace:*",
        "@neon/config": "^1.14.0",
        "@neon/env": "^2.1.3",
        "cors": "^2.8.6",
        "drizzle-orm": "^0.45.4",
        "express": "^5.3.0",
        "pg": "^8.23.1"
    },
    "devDependencies": {
        "@types/bun": "^1.4.4",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.11",
        "typescript": "^7.0.2"
    },
    "packageManager": "bun@1.4.4"
}
