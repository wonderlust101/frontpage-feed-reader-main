# ── Server ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# ── Database (Neon) ────────────────────────────────────────────
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Auth (Better Auth) ─────────────────────────────────────────
# Secret that signs session cookies: at least 32 random characters (e.g. `openssl rand -base64 32`). Required in production.
AUTH_SECRET=
# Public URL of the auth endpoints (/api/auth/*); password-reset links point here. Required in production (the API won't start without it).
AUTH_URL=http://localhost:4000

# ── Email (password reset, email codes) ────────────────────────
# Without RESEND_API_KEY, emails go to Mailpit when MAILPIT_URL is set, else they are printed to the backend log (outside production).
RESEND_API_KEY=
EMAIL_FROM="Frontpage <onboarding@resend.dev>"
# Mailpit, the local test inbox: start it with `docker compose up mailpit` and read emails at http://localhost:8025. Ignored in production.
MAILPIT_URL=

# ── Feed fetching ──────────────────────────────────────────────
FEED_FETCH_TIMEOUT_MS=10000
FEED_USER_AGENT="Frontpage/0.1 (RSS reader)"
FEED_MAX_CONCURRENCY=5
FEED_MIN_REFETCH_MINUTES=15
# Background refresh of all feeds, in minutes; 0 disables it.
FEED_REFRESH_INTERVAL_MINUTES=30
# Allow fetching feeds from loopback (127.0.0.1, ::1). Keep false outside tests (SSRF protection).
FEED_ALLOW_LOOPBACK=false
