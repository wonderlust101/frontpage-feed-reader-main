# ── Server ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# ── Database (Neon) ────────────────────────────────────────────
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Auth ───────────────────────────────────────────────────────
AUTH_SECRET=
AUTH_URL=http://localhost:4000

# ── Email (password reset) ─────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Frontpage <onboarding@resend.dev>"

# ── Feed fetching ──────────────────────────────────────────────
FEED_FETCH_TIMEOUT_MS=10000
FEED_USER_AGENT="Frontpage/0.1 (RSS reader)"
FEED_MAX_CONCURRENCY=5
FEED_MIN_REFETCH_MINUTES=15
FEED_REFRESH_INTERVAL_MINUTES=30
# Allow fetching feeds from localhost/private IPs. Keep false outside tests (SSRF protection).
FEED_ALLOW_PRIVATE_HOSTS=false
