# ── Server ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# The deployment's URLs (WEB_ORIGIN, AUTH_URL, AUTH_COOKIE_DOMAIN, AUTH_COOKIE_PREFIX) come from
# packages/shared/src/deployments.ts: Railway's RAILWAY_ENVIRONMENT_NAME picks production or staging, anywhere else is
# local. Leave them out of Railway's settings; set one only to override it.
# Sites allowed to call the API, comma-separated. Prefer exact addresses: Better Auth also accepts a * wildcard, but it
# trusts every site the pattern matches, so never use one as broad as *.vercel.app.
# WEB_ORIGIN=

# ── Database (Neon) ────────────────────────────────────────────
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Auth (Better Auth) ─────────────────────────────────────────
# Secret that signs session cookies: at least 32 random characters (e.g. `openssl rand -base64 32`). Required in production.
AUTH_SECRET=
# This API's public address, which the browser calls for /api/auth/*. Emailed links are built from it. No path:
# Better Auth would treat it as where its routes live, and every /api/auth/* request would 404.
# AUTH_URL=
# The domain the site and the API share the session cookie on.
# AUTH_COOKIE_DOMAIN=
# Session cookie name prefix (staging's keeps it apart from production's).
# AUTH_COOKIE_PREFIX=

# ── Email (password reset, email codes) ────────────────────────
# Without RESEND_API_KEY, emails go to Mailpit when MAILPIT_URL is set, else they are printed to the backend log (outside production).
RESEND_API_KEY=
EMAIL_FROM="Frontpage <onboarding@resend.dev>"
# Mailpit, the local test inbox: start it with `docker compose up mailpit` and read emails at http://localhost:8025. Ignored in production.
MAILPIT_URL=

# ── Feed fetching ──────────────────────────────────────────────
FEED_FETCH_TIMEOUT_MS=10000
FEED_USER_AGENT="Frontpage/0.1 (RSS reader)"
# How often a healthy feed is refreshed in the background; subscribing also reuses a feed fetched this recently.
FEED_MIN_REFETCH_MINUTES=15
# Allow fetching feeds from loopback (127.0.0.1, ::1). Keep false outside tests (SSRF protection).
FEED_ALLOW_LOOPBACK=false
# Background refresh. Defaults to true on Railway and false elsewhere (on the host, .env points at Neon); Docker sets true.
# FEED_REFRESH_ENABLED=false
# Minutes between background refresh bursts. Each burst refreshes every feed due before the next one, so Neon can sleep in between.
FEED_REFRESH_TICK_MINUTES=15
# Politeness per feed host: at most this many fetches at once, started at least this many milliseconds apart.
FEED_HOST_MAX_CONCURRENT=2
FEED_HOST_MIN_INTERVAL_MS=1000
