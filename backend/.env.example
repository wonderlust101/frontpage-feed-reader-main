# ── Server ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Sites allowed to call the API, comma-separated. Production: https://www.readfrontpage.com. Prefer exact addresses:
# Better Auth also accepts a * wildcard, but it trusts every site the pattern matches, so never use one as broad as *.vercel.app.
WEB_ORIGIN=http://localhost:3000

# ── Database (Neon) ────────────────────────────────────────────
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Auth (Better Auth) ─────────────────────────────────────────
# Secret that signs session cookies: at least 32 random characters (e.g. `openssl rand -base64 32`). Required in production.
AUTH_SECRET=
# This API's public address, which the browser calls for /api/auth/*. Emailed links are built from it (they open here,
# then send the reader on to the site). Production: https://api.readfrontpage.com. Required in production.
AUTH_URL=http://localhost:4000
# The domain the site and the API share; the session cookie is set for all of it, so the site's pages see it.
# Production: readfrontpage.com. Required in production; leave empty locally (localhost ports already share cookies).
AUTH_COOKIE_DOMAIN=
# Session cookie name prefix. Leave empty (Better Auth's "better-auth") except on staging: frontpage-staging, so
# production's cookie, which also reaches staging.readfrontpage.com, isn't mistaken for staging's. Set the same on Vercel.
AUTH_COOKIE_PREFIX=

# ── Email (password reset, email codes) ────────────────────────
# Without RESEND_API_KEY, emails go to Mailpit when MAILPIT_URL is set, else they are printed to the backend log (outside production).
RESEND_API_KEY=
EMAIL_FROM="Frontpage <onboarding@resend.dev>"
# Mailpit, the local test inbox: start it with `docker compose up mailpit` and read emails at http://localhost:8025. Ignored in production.
MAILPIT_URL=

# ── Feed fetching ──────────────────────────────────────────────
FEED_FETCH_TIMEOUT_MS=10000
FEED_USER_AGENT="Frontpage/0.1 (RSS reader)"
FEED_MAX_CONCURRENCY=5
FEED_MIN_REFETCH_MINUTES=15
# Background refresh of all feeds, in minutes; 0 disables it.
FEED_REFRESH_INTERVAL_MINUTES=30
# Allow fetching feeds from loopback (127.0.0.1, ::1). Keep false outside tests (SSRF protection).
FEED_ALLOW_LOOPBACK=false
