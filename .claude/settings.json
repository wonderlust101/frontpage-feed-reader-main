{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "deny": [
            "Read(**/.env)",
            "Read(**/.env.local)",
            "Read(**/.env.*.local)",
            "Read(**/.env.development)",
            "Read(**/.env.production)",
            "Read(**/.env.test)",
            "Read(**/http-client.private.env.json)",
            "Read(**/.vercel/**)",
            "Read(**/*.pem)",
            "Read(**/*.key)",
            "Bash(cat **/.env*)",
            "Bash(vercel env pull:*)",
            "Bash(railway variables:*)",
            "Bash(railway run:*)"
        ]
    }
}
