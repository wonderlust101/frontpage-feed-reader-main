# ───────────────────────────────────────────────────────────────
# frontend environment
# Local: copy to frontend/.env.local  ·  Vercel: Project → Settings → Environment Variables
# ───────────────────────────────────────────────────────────────

# ── API ────────────────────────────────────────────────────────
# Base URL of the Express API (server-side only).
# On Vercel: the Railway backend's public URL, e.g. https://frontpage-backend.up.railway.app
API_URL=http://localhost:4000

# ── Site ───────────────────────────────────────────────────────
# Canonical public URL (metadata, Open Graph, absolute links). Exposed to the browser.
# On Vercel: your production domain, e.g. https://frontpage.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
