# ───────────────────────────────────────────────────────────────
# frontend environment
# Local: copy to frontend/.env.local  ·  Vercel: Project → Settings → Environment Variables
# ───────────────────────────────────────────────────────────────

# ── API ────────────────────────────────────────────────────────
# Base URL of the Express API for server-side calls (session checks, health).
# On Vercel: https://api.readfrontpage.com
API_URL=http://localhost:4000
# The API's address as the browser sees it (sign-in, sign-up and the other auth calls). Baked in at build time, so on
# Vercel set it for builds too. On Vercel: https://api.readfrontpage.com. Testing on a phone: http://<your LAN IP>:4000.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Site ───────────────────────────────────────────────────────
# Canonical public URL (metadata, Open Graph, absolute links). Exposed to the browser.
# On Vercel: https://www.readfrontpage.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
